# ==============================================================================
# PeerGear Production Environment Configuration (.env)
# ==============================================================================

# 1. Django Core Settings
SECRET_KEY=generate_a_random_long_secret_key_here
DJANGO_DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1

# 2. Production MongoDB Database (e.g. MongoDB Atlas Connection String)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=campusshare_production_db

# 3. Live Gmail SMTP Delivery for Student OTPs
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_college_or_admin_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_google_app_password
DEFAULT_FROM_EMAIL=PeerGear Campus <your_college_or_admin_email@gmail.com>

# 4. Frontend API Connection (For Vercel / Netlify / Cloud deployments)
# Set VITE_API_URL in your frontend platform environment variables:
# VITE_API_URL=https://your-backend-api.onrender.com/api
